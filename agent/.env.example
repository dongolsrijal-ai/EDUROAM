# Copy to agent/.env.local for local runs (never commit it). In LiveKit Cloud set the same names as
# agent secrets (lk agent update-secrets, or Agents -> eduroam-tutor -> Secrets in the dashboard).

# LiveKit project (LiveKit Cloud -> Settings -> API keys). Not needed in LiveKit Cloud itself.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gemini API key for Gemini Live (Google AI Studio -> API keys).
GOOGLE_API_KEY=
# Optional: keep the voice / model you picked in Agent Builder.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Puck

# EDUROAM protected endpoint + shared secret (the same value as the Supabase secret VOICE_AGENT_SECRET).
EDUROAM_VOICE_AGENT_URL=https://horhkariflujndhttrhr.supabase.co/functions/v1/voice-agent
VOICE_AGENT_SECRET=

# Self-hosted: register under its own dispatch name (the Agent Builder deployment holds "eduroam-tutor").
# Must equal the Supabase secret VOICE_AGENT_NAME. Use eduroam-tutor-dev for local experiments instead.
LIVEKIT_AGENT_NAME_OVERRIDE=eduroam-tutor-code

# Hosting limits (optional; defaults shown). See DEPLOY.md.
# MAX_CALL_MINUTES=45
# AGENT_IDLE_PROCESSES=1
# JOB_MEMORY_LIMIT_MB=1500
# Railway health checks call $PORT: the worker's health server listens on 8081.
# PORT=8081
