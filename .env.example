# Copy to .env.local (git-ignored). Browser-safe values only: the publishable key is public
# by design and every table is protected by Row Level Security.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# NEVER put GEMINI_API_KEY or a Supabase secret/service key here: anything prefixed VITE_
# is bundled into the game. Server secrets go in Supabase Edge Function secrets
# (see supabase/functions/.env.example and docs/supabase-setup.md).
